[Unit]
Description=VIMS Opportunity Board private admin (loopback only)
After=network.target

[Service]
Type=simple
User=shiny
Group=shiny
WorkingDirectory=/home/risdell/vims-opportunity-board-vims/admin
ExecStart=/usr/bin/Rscript -e "shiny::runApp('.', host='127.0.0.1', port=4862, launch.browser=FALSE)"
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
